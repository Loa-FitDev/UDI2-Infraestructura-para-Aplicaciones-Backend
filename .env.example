# Variables de entorno para despliegue en VPS con Supabase
# Copia este archivo a .env y completa con tus credenciales reales
# NO subas el archivo .env a Git (está en .gitignore)

# Connection String de Supabase en formato Npgsql (Host;Port;Database;Username;Password)
# Obtén esto desde Supabase Dashboard > Connect > Direct Connection String > URI
# Ejemplo: postgresql://postgres:TU_PASSWORD@db.xxxxxx.supabase.co:5432/postgres
# Conviértelo a: Host=db.xxxxxx.supabase.co;Port=5432;Database=postgres;Username=postgres;Password=TU_PASSWORD
SUPABASE_CONNECTION_STRING=Host=db.xxxxxx.supabase.co;Port=5432;Database=postgres;Username=postgres;Password=TU_CONTRASEÑA